{
  "manifest_version": 3,
  "name": "Time Tracker",
  "version": "1.0",
  "description": "Track your daily browser usage with alerts and limits",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "windows",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "images/icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Time Tracker",
    "default_icon": "images/icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["alert-window.html", "blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
